#include <stdio.h>

int main(void)
{
    int num1 = 35, num2 = 60;

    int* ptr1 = &num1;
    int* ptr2 = &num2;

    int* small;
    int* big;
    int* temp;

    small = (*ptr1 < *ptr2) ? ptr1 : ptr2;
    big = (*ptr1 > *ptr2) ? ptr1 : ptr2;

    *small += 10;
    *big -= 10;

    temp = ptr1;
    ptr1 = ptr2;
    ptr2 = temp;

    printf("num1 값: %d\n", num1);
    printf("num2 값: %d\n", num2);
    printf("ptr1이 가리키는 값: %d\n", *ptr1);
    printf("ptr2가 가리키는 값: %d\n", *ptr2);

    return 0;
}
