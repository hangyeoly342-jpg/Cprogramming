#define _CRT_SECURE_NO_WARNINGS
#pragma warning(disable:6031)
#include <stdio.h>

int main(void)
{
    double arr[5];
    double *ptr = arr;
    int i;

    printf("5개의 실수를 입력하시오.\n");

    for (i = 0; i < 5; i++)
        scanf("%lf", ptr++);

    ptr = arr;

    for (i = 0; i < 5; i++)
        *(ptr++) += 2.0;

    // 결과 확인
    ptr = arr;

    printf("2씩 증가시킨 결과: ");

    for (i = 0; i < 5; i++)
        printf("%.2f ", *(ptr++));

    printf("\n");

    return 0;
}
